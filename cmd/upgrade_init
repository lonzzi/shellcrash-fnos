#!/bin/bash
set -eu

# Stop rather than silently creating empty mounts if fnOS lost existing state.
for path in \
    "$TRIM_PKGETC/api.secret" \
    "$TRIM_PKGVAR/ShellCrash/configs" \
    "$TRIM_PKGVAR/ShellCrash/yamls" \
    "$TRIM_PKGVAR/ShellCrash/jsons"; do
    [ -e "$path" ] || {
        echo "Existing ShellCrash configuration is missing: $path. Upgrade stopped to protect data." > "$TRIM_TEMP_LOGFILE"
        exit 1
    }
done

# Older package revisions may not have seeded the upstream S6 command file.
if [ ! -s "$TRIM_PKGVAR/ShellCrash/configs/command.env" ]; then
    tmp=$(mktemp "$TRIM_PKGVAR/ShellCrash/configs/command.env.XXXXXX")
    trap 'rm -f "$tmp"' EXIT
    cat > "$tmp" <<'EOF'
TMPDIR='/tmp/ShellCrash'
BINDIR='/etc/ShellCrash'
COMMAND='"/tmp/ShellCrash/CrashCore" -d "/etc/ShellCrash" -f "/tmp/ShellCrash/config.yaml"'
EOF
    chmod 600 "$tmp"
    mv "$tmp" "$TRIM_PKGVAR/ShellCrash/configs/command.env"
fi
