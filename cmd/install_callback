#!/bin/bash
set -eu
[ -s "$TRIM_PKGETC/api.secret" ] || { echo 'ShellCrash API secret was not initialized' > "$TRIM_TEMP_LOGFILE"; exit 1; }
[ -s "$TRIM_PKGVAR/ShellCrash/configs/ShellCrash.cfg" ] || { echo 'ShellCrash config was not initialized' > "$TRIM_TEMP_LOGFILE"; exit 1; }
[ -s "$TRIM_PKGVAR/ShellCrash/yamls/config.yaml" ] || { echo 'Starter profile was not initialized' > "$TRIM_TEMP_LOGFILE"; exit 1; }
[ -x "$TRIM_APPDEST/bin/mihomo" ] || { echo 'Native Mihomo binary is missing' > "$TRIM_TEMP_LOGFILE"; exit 1; }
[ -x "$TRIM_APPDEST/bin/shellcrash-manager" ] || { echo 'Native ShellCrash manager is missing' > "$TRIM_TEMP_LOGFILE"; exit 1; }
[ -s "$TRIM_APPDEST/dashboard/index.html" ] || { echo 'MetaCubeXD dashboard files are missing' > "$TRIM_TEMP_LOGFILE"; exit 1; }
